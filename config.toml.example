# Tempered gameplay configuration reference.
# Copy to <instance-or-server>/config/tempered/config.toml, then restart the world/server.
# SERVER settings are authoritative; connected clients receive the active values.
# An existing world/serverconfig/tempered/config.toml overrides the normal file.
# Edits while running are pending until restart, including for players joining later.
# Individual invalid values are corrected to defaults by NeoForge (with a backup).
# Mismatched Executioner tier-list lengths use the entire default Executioner section.
# Saved levels/progress survive disabling or lowering caps; effective bonuses use the new cap.
# Reinforced equipment recalculates when carried/used, retaining its remaining durability fraction.
# Executioner continues recording progress beyond the current highest tier (integer saturation).
# Aspects always apply successfully; no application chance or random smithing preview is used.
# Eligibility and acquisition recipes remain controlled by datapacks.
# Example: a bonus list [5.0, 17.5] gives two levels with total bonuses of 5% and 17.5%.
# Example: use milestones [64, 192, 384] for slower Executioner progression.
# Example: execute chances [0.1, 0.3, 0.75] give 10%, 30%, 75% success at the three tiers.
# Generated by ./gradlew updateConfigExample. ./gradlew test rejects a stale example.

[affixes.executioner]
# Allow creative-mode kills to earn progress. Does not change combat eligibility.
allow_creative_progression = false
# Show the player a message when a weapon reaches a new tier.
announce_tier_up = true
# Enable Executioner effects and progression; saved history is retained.
enabled = true
# Probability per qualifying hit, each 0-1. Must match milestone list length. No roll for ineligible or naturally lethal hits.
execute_chance_by_tier = [1.0, 1.0, 1.0]
# Maximum-health execute threshold per tier, each 0-100 percent. Must match milestone list length.
execute_health_percent_by_tier = [5.0, 10.0, 15.0]
# Total progress required per tier: 1-100 strictly increasing integers, each 1-2147483647.
kills_required_by_tier = [2, 5, 10]
# Probability per qualifying melee kill: 0 never, 0.25 = 25%, 1 always.
#  Default: 1.0
#  Range: 0.0 ~ 1.0
progress_chance = 1.0
# Progress awarded by a successful kill roll, 1-2147483647. Counter saturates safely.
#  Default: 1
#  Range: > 1
progress_per_success = 1
# Allow earning progress. Existing tiers still work when false.
progression_enabled = true

[aspects.reinforced]
# Total bonus percent at each level (not cumulative). 1-100 entries, each 0-10000. List length is the level cap.
durability_bonus_percent_by_level = [10.0, 20.0, 30.0, 40.0, 50.0]
# Enable Reinforced. Disabling preserves saved progression.
enabled = true

[aspects.swift]
# Enable Swift. Disabling preserves saved progression.
enabled = true
# Total bonus percent at each level (not cumulative). 1-100 entries, each 0-10000. List length is the level cap.
mining_speed_bonus_percent_by_level = [8.0, 16.0, 24.0, 32.0, 40.0]
